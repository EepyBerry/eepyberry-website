{
  "name": "eepyberry-website",
  "version": "1.4.1",
  "description": "EepyBerry's personal website",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "build": "run-p type-check prettify \"build-only {@}\" --",
    "preview": "vite preview",
    "preview-host": "vite preview --host",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "prettify": "prettier . --write",
    "lint": "eslint . --fix --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EepyBerry/eepyberry-website.git"
  },
  "keywords": [
    "vue",
    "vuejs",
    "typescript"
  ],
  "author": "EepyBerry",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/EepyBerry/eepyberry-website/issues"
  },
  "homepage": "https://github.com/EepyBerry/eepyberry-website#readme",
  "dependencies": {
    "@floating-ui/vue": "^1.1.9",
    "@unhead/vue": "^2.1.1",
    "iconify-icon": "^3.0.2",
    "vue": "3.5.26",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "sass": "^1.97.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vue-tsc": "^3.2.1"
  }
}
